# Address of your deployed Aegis contract + which network it's on.
# Values are inlined at BUILD time by Next.js -- Vercel rebuilds are required
# after changing these. Real addresses used for this repo's testnet deploys are
# recorded in docs/DEPLOYMENT.md.

# Network the contract is deployed on: "studionet" (default) or
# "testnet-bradbury". Maps internally to genlayer-js's studionet /
# testnetBradbury chains.
NEXT_PUBLIC_AEGIS_NETWORK=studionet

# Address returned by `genlayer deploy --contract intelligent-contracts/aegis.py`.
# StudioNet (gasless, used by the Vercel frontend) -- canonical, e2e 28/28:
NEXT_PUBLIC_AEGIS_CONTRACT_ADDRESS=0xED90a97A77cd959bB278cBDfA0f2981dF5b5B843
# Bradbury alternative: 0xcBF48A444242919EEA65Ff5bB6BD9d2CB82506e2 (needs NEXT_PUBLIC_AEGIS_NETWORK=testnet-bradbury)
